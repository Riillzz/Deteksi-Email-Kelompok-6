# Salin menjadi .streamlit/secrets.toml untuk penggunaan lokal.
# Jangan commit file secrets.toml asli ke GitHub.

# Wajib diisi jika ingin menggunakan dashboard admin.
# Hasilkan hash dengan: python generate_admin_hash.py
ADMIN_PASSWORD_HASH = "PASTE_PBKDF2_HASH_FROM_GENERATOR_HERE"

# OPSIONAL untuk deploy publik: isi kedua nilai ini setelah membuat project Supabase
# dan menjalankan supabase_schema.sql. Jika tidak diisi, aplikasi memakai SQLite lokal.
# Gunakan secret key (awalan sb_secret_) di sisi server, BUKAN publishable key.
# SUPABASE_URL = "https://YOUR_PROJECT_ID.supabase.co"
# SUPABASE_SECRET_KEY = "sb_secret_REPLACE_WITH_YOUR_OWN_KEY"
# Untuk project lama, SUPABASE_SERVICE_ROLE_KEY juga didukung.
